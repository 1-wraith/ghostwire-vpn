{
  "name": "ghostwire-vpn",
  "version": "1.0.0",
  "description": "GhostWire VPN - 100% Açık Kaynaklı, Sıfır Kayıtlı Kuantum Gizlilik Kalkanı ve Sansür Engel Kırıcı",
  "main": "electron-main.js",
  "author": "1-wraith",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "build:exe": "electron-builder --win nsis",
    "build:dir": "electron-builder --win dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.ghostwire.vpn",
    "productName": "GhostWire VPN",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GhostWire VPN"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
