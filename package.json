{
  "name": "ghostwire-vpn",
  "version": "1.2.2",
  "description": "GhostWire VPN - 100% Açık Kaynaklı, Sıfır Kayıtlı Kuantum Gizlilik Kalkanı ve Sansür Engel Kırıcı",
  "main": "electron-main.js",
  "author": "1-wraith",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "clean:dist": "node -e \"const fs=require('fs'),path=require('path'); const d='dist'; if(fs.existsSync(d)){ fs.readdirSync(d).forEach(f=>{ if(f.endsWith('.exe')||f.endsWith('.AppImage')||f.endsWith('.deb')||f.endsWith('.blockmap')||f.endsWith('.dmg')||f.endsWith('.zip')) fs.rmSync(path.join(d,f),{force:true}); }); }\"",
    "build:exe": "npm run clean:dist && electron-builder --win nsis",
    "build:dir": "electron-builder --win dir",
    "build:linux": "npm run clean:dist && electron-builder --linux AppImage deb",
    "build:mac": "npm run clean:dist && electron-builder --mac dmg",
    "build:all": "npm run clean:dist && electron-builder -mwl",
    "dist": "npm run clean:dist && electron-builder"
  },
  "build": {
    "appId": "com.ghostwire.vpn",
    "productName": "GhostWire VPN",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GhostWire VPN"
    },
    "linux": {
      "target": ["AppImage", "deb", "tar.gz"],
      "category": "Network",
      "icon": "assets/icon.png",
      "maintainer": "1-wraith <contact@ghostwirevpn.org>",
      "synopsis": "GhostWire VPN - 0-Logs Quantum Stealth Privacy Shield"
    },
    "deb": {
      "depends": ["libnotify4", "libxtst6", "libnss3"]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "GhostWire VPN",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
